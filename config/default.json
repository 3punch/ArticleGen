{
  "max_iterations": 4,
  "score_target": 0.85,
  "min_delta": 0.01,
  "stall_window": 2,
  "provider": "auto",
  "workspace": "runs",
  "changelog_path": "change_log.md",
  "token_budget": {
    "context_hard_cap": 4800,
    "context_soft_warn": 3800,
    "run_token_ceiling": 42000,
    "reserve_for_response": 2000,
    "agents": {
      "writer": { "max_input_tokens": 2000, "max_output_tokens": 2000 },
      "tester": { "max_input_tokens": 2000, "max_output_tokens": 800 },
      "reviewer": { "max_input_tokens": 2000, "max_output_tokens": 800 },
      "architect": { "max_input_tokens": 1800, "max_output_tokens": 700 },
      "synthesizer": { "max_input_tokens": 2400, "max_output_tokens": 2200 }
    }
  }
}
